{
  "extends": "../config/tsconfig/base.json",
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    // Type Checking & Safety
    "strict": true,
    "noEmit": true,

    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "exclude": ["samples"]
}
