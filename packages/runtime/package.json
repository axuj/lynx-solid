{
  "name": "@lynx-solid/runtime",
  "type": "module",
  "version": "0.1.1",
  "description": "Solid 2 runtime for Lynx — dual-thread background renderer, main-thread bootstrap, and the shared ops protocol",
  "license": "MIT",
  "homepage": "https://axuj.github.io/lynx-solid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axuj/lynx-solid.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/axuj/lynx-solid/issues"
  },
  "keywords": [
    "lynx",
    "solid",
    "solidjs",
    "renderer",
    "cross-thread",
    "ui"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./lynx-template": {
      "types": "./dist/background/lynx-template.d.ts",
      "default": "./dist/background/lynx-template.js"
    },
    "./main-thread": {
      "types": "./dist/main-thread/index.d.ts",
      "default": "./dist/main-thread/index.js"
    },
    "./ifr-runtime": {
      "types": "./dist/main-thread/ifr-runtime.d.ts",
      "default": "./dist/main-thread/ifr-runtime.js"
    },
    "./bootstrap": {
      "types": "./dist/background/bootstrap.d.ts",
      "default": "./dist/background/bootstrap.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "solid-js": "catalog:"
  },
  "dependencies": {
    "@lynx-js/types": "^4.3.0",
    "@solidjs/universal": "catalog:"
  },
  "devDependencies": {
    "@dom-expressions/runtime": "0.50.0-next.44",
    "@lynx-js/type-element-api": "0.0.10",
    "solid-js": "catalog:",
    "typescript": "catalog:"
  }
}
