{
  "name": "@lynx-solid/compiler",
  "type": "module",
  "version": "0.1.1",
  "description": "Solid → Lynx compile pipeline — the forked dom-expressions Babel plugin, dom-compile, and worklet utilities",
  "license": "MIT",
  "homepage": "https://axuj.github.io/lynx-solid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axuj/lynx-solid.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/axuj/lynx-solid/issues"
  },
  "keywords": [
    "lynx",
    "solid",
    "compiler",
    "babel-plugin",
    "jsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "mt-macro.cjs"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && rslib build",
    "build:fork-plugin": "rslib build -c rslib.fork-plugin.config.ts",
    "typecheck": "tsc -b && tsc -b babel-plugin-jsx-lynx"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/helper-module-imports": "^7.29.0",
    "@babel/parser": "^7.29.0",
    "@babel/plugin-syntax-jsx": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@lynx-js/react": "catalog:",
    "babel-plugin-transform-async-to-promises": "^0.8.18",
    "html-entities": "^2.6.0"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "typescript": "catalog:"
  }
}
