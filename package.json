{
  "name": "lynx-solid",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "nub@0.9.7",
  "description": "Solid 2 → Lynx renderer (monorepo: runtime, compiler, plugin, sample apps)",
  "license": "MIT",
  "homepage": "https://axuj.github.io/lynx-solid/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axuj/lynx-solid.git"
  },
  "bugs": {
    "url": "https://github.com/axuj/lynx-solid/issues"
  },
  "engines": {
    "node": "26.x"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "examples/*",
      "website"
    ],
    "catalog": {
      "@lynx-js/react": "^0.125.0",
      "@lynx-js/rsbuild-plugin": "0.1.6",
      "@lynx-js/runtime-wrapper-webpack-plugin": "^0.2.5",
      "@lynx-js/tailwind-preset": "^0.5.1",
      "@lynx-js/template-webpack-plugin": "^0.13.0",
      "@lynx-js/types": "4.3.0",
      "@rsbuild/core": "2.2.14",
      "@rslib/core": "^0.23.2",
      "@rspack/core": "^2.2.9",
      "@solidjs/universal": "2.0.0-rc.18",
      "eslint": "^10.13.0",
      "rsbuild-plugin-tailwindcss": "^0.2.4",
      "sass": "^1.106.1",
      "solid-js": "2.0.0-rc.18",
      "tailwindcss": "^3.4.17",
      "typescript": "^5.5.0",
      "vitest": "^3.0.0"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix --cache .",
    "typecheck": "nub run -F @lynx-solid/runtime build && nub run -F @lynx-solid/runtime typecheck && nub run -F @lynx-solid/compiler typecheck && nub run -F @lynx-solid/plugin typecheck && tsc --noEmit -p ./tests/tsconfig.json",
    "test": "nub run -F @lynx-solid/compiler build:fork-plugin && vitest run tests/protocol",
    "verify:unit": "nub run -F @lynx-solid/compiler build:fork-plugin && vitest run tests/behavior tests/compiler tests/ports",
    "bench:react-lynx": "vitest run tests/bench/react-lynx-compare.test.ts",
    "lab:dev": "nub run -F @lynx-solid/compiler build:fork-plugin && vite --config ./compile-lab/vite.config.ts",
    "lab:build": "vite build --config ./compile-lab/vite.config.ts",
    "lab:typecheck": "tsc --noEmit -p ./compile-lab/tsconfig.json",
    "build": "tsc -b && nub run -F @lynx-solid/compiler build && nub run -F @lynx-solid/compiler build:fork-plugin && nub run -F @lynx-solid/plugin build",
    "build:examples": "nub run -F @lynx-solid/dev-counter build && nub run -F @lynx-solid/dev-main-thread-draggable build && nub run -F @lynx-solid/dev-mini-pure build && nub run -F @lynx-solid/dev-todomvc build && nub run -F @lynx-solid/dev-7guis build && nub run -F @lynx-solid/dev-scrolling build && nub run -F @lynx-solid/dev-touch-fx build && nub run -F @lynx-solid/dev-networking build && nub run -F @lynx-solid/dev-tailwind build && nub run -F @lynx-solid/dev-hackernews build && nub run -F @lynx-solid/dev-elk build && nub run -F @lynx-solid/dev-motion build && nub run -F @lynx-solid/dev-style-demo build",
    "docs:prepare": "nub run -F @lynx-solid/website prepare-examples",
    "docs:dev": "nub run -F @lynx-solid/website dev",
    "docs:dev:full": "nub run -F @lynx-solid/website dev:full",
    "docs:build": "nub run -F @lynx-solid/website build",
    "docs:typecheck": "nub run -F @lynx-solid/website typecheck",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:publish": "node scripts/release.mjs --publish --provenance",
    "dev": "nub run -F @lynx-solid/runtime build && nub run -F @lynx-solid/dev-elk dev"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/helper-module-imports": "^7.29.0",
    "@babel/parser": "^7.29.0",
    "@babel/plugin-syntax-jsx": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@lynx-solid/compiler": "workspace:*",
    "@lynx-solid/plugin": "workspace:*",
    "@lynx-solid/runtime": "workspace:*",
    "@tanstack/solid-router": "2.0.0-rc.9",
    "babel-plugin-transform-async-to-promises": "^0.8.18",
    "html-entities": "^2.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@babel/generator": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/standalone": "8.0.4",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@dom-expressions/runtime": "0.50.0-next.44",
    "@lynx-js/qrcode-rsbuild-plugin": "0.7.3",
    "@lynx-js/react": "catalog:",
    "@lynx-js/rsbuild-plugin": "catalog:",
    "@lynx-js/runtime-wrapper-webpack-plugin": "catalog:",
    "@lynx-js/tailwind-preset": "catalog:",
    "@lynx-js/template-webpack-plugin": "catalog:",
    "@lynx-js/type-element-api": "0.0.10",
    "@lynx-js/types": "catalog:",
    "@lynx-js/web-core": "^0.26.5",
    "@lynx-js/web-elements": "0.12.15",
    "@lynx-js/web-rsbuild-server-middleware": "^0.26.5",
    "@microsoft/api-extractor": "^7.59.4",
    "@rsbuild/core": "catalog:",
    "@rslib/core": "catalog:",
    "@rspack/core": "catalog:",
    "@solidjs/meta": "^1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.42",
    "@solidjs/signals": "2.0.0-rc.18",
    "@solidjs/universal": "catalog:",
    "@solidjs/vite-plugin": "^3.0.0-next.39",
    "@solidjs/web": "2.0.0-rc.18",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__standalone": "^7.1.9",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.6.5",
    "@types/split.js": "^1.6.0",
    "babel-loader": "^10.1.1",
    "babel-preset-solid": "2.0.0-rc.2",
    "core-js": "3.51.0",
    "eslint": "catalog:",
    "eslint-plugin-solid": "^0.16.0",
    "filesystem-routing": "0.2.1",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3",
    "masto": "^7.2.0",
    "rsbuild-plugin-tailwindcss": "catalog:",
    "sass": "catalog:",
    "solid-js": "catalog:",
    "split.js": "^1.6.5",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "ultrahtml": "^1.7.0",
    "vite": "^8.1.5",
    "vitest": "catalog:",
    "webpack-virtual-modules": "^0.6.2"
  },
  "overrides": {
    "@babel/standalone": "8.0.4",
    "@solidjs/signals": "2.0.0-rc.18"
  }
}
